const express = require('express');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 3000;

// Configuración para servir archivos estáticos desde la carpeta 'static'
app.use(express.static(path.join(__dirname, 'static')));
// Middleware para parsear cuerpos de solicitud en formato JSON
app.use(express.json());

// Almacenamiento en memoria para las solicitudes de asistencia (no persistente)
const assistanceRequests = [];

// Ruta principal para servir el archivo HTML 'curse.html'
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, 'curse.html'));
});

// Endpoint API para recibir nuevas solicitudes de asistencia
app.post('/api/assist', (req, res) => {
    const { nombre, contacto, mensaje } = req.body;

    // Validación básica de campos
    if (!nombre || !contacto || !mensaje) {
        return res.status(400).json({ success: false, message: 'Todos los campos son obligatorios.' });
    }

    // Creación y almacenamiento de la nueva solicitud
    const newRequest = {
        id: assistanceRequests.length + 1,
        nombre,
        contacto,
        mensaje,
        timestamp: new Date().toISOString()
    };
    assistanceRequests.push(newRequest);
    console.log('Nueva solicitud de asistencia recibida:', newRequest); // Log para seguimiento

    // Respuesta de éxito al cliente
    res.status(201).json({ success: true, message: 'Su solicitud ha sido recibida con éxito. Nos pondremos en contacto pronto.' });
});

// Manejador para rutas no encontradas (404)
app.use((req, res, next) => {
    // Intenta servir un archivo 404.html personalizado
    res.status(404).sendFile(path.join(__dirname, 'static', '404.html'), (err) => {
        // Si 404.html no existe o hay un error, envía una respuesta de texto simple
        if (err) {
            res.status(404).send('Página no encontrada.');
        }
    });
});

// Manejador de errores general
app.use((err, req, res, next) => {
    console.error(err.stack); // Log del error
    res.status(500).send('Algo salió mal en el servidor.');
});

// Iniciar el servidor
app.listen(PORT, () => {
    console.log(`Servidor de Bienestar escuchando en el puerto ${PORT}`);
});
